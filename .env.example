# DevMind Environment Configuration Example
# Copy this file to backend/.env and frontend/.env.local with your real values

# Application Settings
APP_NAME=DevMind
DEBUG=true

# Database (PostgreSQL) - Target Phase 3
POSTGRES_USER=devmind
POSTGRES_PASSWORD=devmind_secret
POSTGRES_DB=devmind
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devmind:devmind_secret@localhost:5432/devmind

# Vector Database (Qdrant) - Target Phase 8
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=devmind_documents

# Cache & Message Broker (Redis) - Target Phase 19
REDIS_URL=redis://localhost:6379

# Security & Authentication - Target Phase 4
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Models & Providers - Target Phase 11
GOOGLE_API_KEY=your-google-gemini-api-key-here
